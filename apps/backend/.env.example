# 后端环境变量（复制为 .env；未列出的取代码内默认值，见 src/config/env.validation.ts）
APP_PORT=3000
API_PREFIX=api

# docker compose 里的 mysql（宿主端口 3307，见 docs/ISSUES.md #1）
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=store123456
DB_DATABASE=store_web_project

# 逗号分隔的 CORS 允许来源
CORS_ORIGINS=http://localhost:5173

# JWT（secret ≥16 字符；EXPIRES_IN 支持 2h/7d 等；THRESHOLD 为滑动续期阈值秒数）
JWT_SECRET=store-web-dev-secret-0730
JWT_EXPIRES_IN=2h
JWT_RENEW_THRESHOLD_S=1800
